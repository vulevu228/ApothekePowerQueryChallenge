table Orders
	lineageTag: 9a23719b-4db2-4118-8c52-89879a5f23cb

	measure 'Total Net Revenue' = SUM ( Orders[Net Revenue])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: f2a5a3c3-0552-4736-8593-b44db976c658

	measure 'Valid Net Revenue' = CALCULATE( [Total Net Revenue], Orders[Status] IN {"Delivered", "Shipped"})
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 2e59d49e-6457-4e1a-8218-0d6276629f54

	measure 'Valid Orders' = CALCULATE(COUNTROWS (Orders), Orders[Status] IN {"Delivered", "Shipped"})
		formatString: 0
		lineageTag: b205b70e-1a06-46f0-b858-1a0a1fc78de8

	measure 'Total Target' = SUM(Targets[Target EUR])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 52a092d5-1298-43db-805a-e27019538371

	measure 'Achievement %' = DIVIDE([Valid Net Revenue], [Total Target])
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 5dd67a35-98ae-41b2-a971-d4900a2000e1

	measure 'Gap to Target' = [Valid Net Revenue] - [Total Target]
		formatString: +#,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: df9bcbd6-7a1e-4c2b-9d3f-6e5a4b3c2d1e

	measure 'Achievement Color' = IF ( [Achievement %] >= 1, "#1F8A70", "#D9822B" )
		lineageTag: 6ac70acf-3b2c-4d1e-8f7a-1c2d3e4f5a6b

