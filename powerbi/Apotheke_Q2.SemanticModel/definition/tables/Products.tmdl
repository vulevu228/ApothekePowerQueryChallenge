				  #"Merged queries" = Table.NestedJoin(#"Changed column type", {"Category ID"}, Categories, {"Category ID"}, "Categories", JoinKind.LeftOuter),
				  #"Expanded Categories" = Table.ExpandTableColumn(#"Merged queries", "Categories", {"Category"}, {"Category"})
				in
